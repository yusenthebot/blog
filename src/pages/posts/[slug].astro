---
import "katex/dist/katex.min.css";
import { render } from "astro:content";
import { getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ArticleShare from "../../components/ArticleShare.astro";
import FigureViewer from "../../components/FigureViewer.astro";
import Video from "../../components/Video.astro";
import ep10Figure from "../../content/posts/ep10-fast-slow-brain/fig-stack.png?url";
import macmimicFigure from "../../content/posts/macmimic/fig-pipeline.png?url";
import { getPosts, postPath, type Post } from "../../lib/posts";
import { SERIES, formatDate, withBase } from "../../lib/site";
import { wbrHtml } from "../../lib/cjk-words.mjs";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // posts are newest first: "newer" is the previous one in the list
    props: {
      post,
      newer: posts[i - 1],
      older: posts[i + 1],
      related: posts
        .filter((candidate) => candidate !== post && candidate !== posts[i - 1] && candidate !== posts[i + 1])
        .map((candidate) => ({
          post: candidate,
          tags: candidate.data.tags.filter((tag) => post.data.tags.includes(tag)),
        }))
        .filter(({ tags }) => tags.length > 0)
        .sort((a, b) => b.tags.length - a.tags.length)
        .slice(0, 2),
    },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  related: { post: Post; tags: string[] }[];
}

const { post, newer, older, related } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const og = await getImage({ src: data.cover, width: 1200, format: "jpg" });
const PLATFORM_LABEL = { douyin: "抖音", xiaohongshu: "小红书", tiktok: "TikTok", youtube: "YouTube" } as const;
const isVideo = data.series === "kepu" || data.video;
const originalFigures: Record<string, string | undefined> = {
  "ep10-fast-slow-brain": ep10Figure,
  macmimic: macmimicFigure,
};
const originalFigure = originalFigures[post.id];
---

<Base title={data.title} description={data.description} image={og.src} type="article">
  <article class="article">
    <header class="article-head">
      <div class="crumbs">
        <a href={withBase("/")}>~/posts</a>/{post.id}
      </div>
      <h1 class="article-title px" set:html={wbrHtml(data.title)} />
      <p class="article-lede">{data.description}</p>
      <div class="meta">
        {data.episode && <span class="ep">EP{String(data.episode).padStart(2, "0")}</span>}
        <span>{SERIES[data.series].label}</span>
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
        {data.duration && <span>{data.duration}</span>}
        {data.platforms.length > 0 && <span>{data.platforms.map((p) => PLATFORM_LABEL[p]).join(" / ")}</span>}
      </div>
      {
        data.tags.length > 0 && (
          <div class="tags">
            {data.tags.map((t) => (
              <a class="tag" href={withBase(`/?q=${encodeURIComponent(t)}#posts`)}>#{t}</a>
            ))}
          </div>
        )
      }
    </header>

    {
      isVideo && (
        <div class="media">
          <Video id={data.youtube} title={data.title} poster={data.cover} posterAlt={data.coverAlt} />
        </div>
      )
    }

    <div class="toc-rail">
      <div class="toc-panel">
        {toc.length > 2 && (
          <details class="toc">
            <summary><span class="px zh-px">文章目录</span><span class="toc-count">{toc.length} 节</span></summary>
            <nav aria-label="文章目录">
              <ol>
                {toc.map((h) => (
                  <li class={`depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )}
        <div class="reading-progress" hidden>
          <div
            class="reading-progress-track"
            role="progressbar"
            aria-label="阅读进度"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          ></div>
          <span aria-hidden="true">00%</span>
        </div>
        <ArticleShare title={data.title} placement="rail" />
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>
    {originalFigure && <FigureViewer source={originalFigure} />}

    {
      data.links.length > 0 && (
        <section class="refs" aria-labelledby="refs-title">
          <h2 id="refs-title" class="px">REFERENCES</h2>
          <ol>
            {data.links.map((l) => (
              <li>
                <a href={l.url}>{l.label}</a>
                {l.note && <span class="note"> {l.note}</span>}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {related.length > 0 && (
      <section class="related-reading" aria-labelledby="related-title">
        <h2 class="px zh-px" id="related-title">同主题继续读</h2>
        <ul>
          {related.map(({ post: nextPost, tags }) => (
            <li>
              <a href={withBase(postPath(nextPost))}>
                <span class="related-topics">{tags.slice(0, 2).join(" · ")}</span>
                <span>{nextPost.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <ArticleShare title={data.title} placement="footer" />
    <nav class="pager" aria-label="按时间继续阅读">
      {
        older && (
          <a href={withBase(postPath(older))}>
            <span class="dir">← 较早发布</span>
            <span class="t" set:html={wbrHtml(older.data.title)} />
          </a>
        )
      }
      {
        newer && (
          <a class="next" href={withBase(postPath(newer))}>
            <span class="dir">较新发布 →</span>
            <span class="t" set:html={wbrHtml(newer.data.title)} />
          </a>
        )
      }
    </nav>
  </article>
</Base>

<script>
  const prose = document.querySelector<HTMLElement>(".article > .prose");
  const progress = document.querySelector<HTMLElement>(".reading-progress");
  const track = progress?.querySelector<HTMLElement>(".reading-progress-track");
  const percentage = progress?.querySelector("span");
  const toc = document.querySelector<HTMLDetailsElement>(".toc");
  const nav = toc?.querySelector("nav");
  const list = nav?.querySelector("ol");
  if (prose && progress && track && percentage) {
    if (toc) {
      const wide = matchMedia("(min-width: 1200px)");
      toc.open = wide.matches;
      wide.addEventListener("change", ({ matches }) => { toc.open = matches; });
    }

    const sections = Array.from(list?.querySelectorAll<HTMLAnchorElement>("a") ?? []).flatMap((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      return heading ? [{ link, heading }] : [];
    });
    let current: HTMLAnchorElement | undefined;
    let lastProgress = -1;
    let frame = 0;

    const positionCursor = (link: HTMLAnchorElement) => {
      if (!list || !nav) return;
      list.style.setProperty("--toc-cursor-y", `${link.offsetTop + link.offsetHeight / 2}px`);
      const { top, bottom } = link.getBoundingClientRect();
      const bounds = nav.getBoundingClientRect();
      if (top < bounds.top) nav.scrollTop -= bounds.top - top;
      else if (bottom > bounds.bottom) nav.scrollTop += bottom - bounds.bottom;
    };

    const updateReadingPosition = () => {
      frame = 0;
      const end = prose.getBoundingClientRect().bottom + window.scrollY - window.innerHeight;
      const progressValue = end <= 0 ? 100 : Math.floor(100 * Math.min(1, Math.max(0, window.scrollY / end)));
      if (progressValue !== lastProgress) {
        lastProgress = progressValue;
        track.style.setProperty("--read-progress", `${progressValue}%`);
        track.setAttribute("aria-valuenow", String(progressValue));
        percentage.textContent = `${String(progressValue).padStart(2, "0")}%`;
      }

      let next = sections[0]?.link;
      for (const { link, heading } of sections) {
        if (heading.getBoundingClientRect().top > 144) break;
        next = link;
      }
      if (!next || next === current) return;
      current?.removeAttribute("aria-current");
      current = next;
      current.setAttribute("aria-current", "location");
      if (toc?.open) positionCursor(current);
    };

    function scheduleUpdate() {
      if (!frame) frame = requestAnimationFrame(updateReadingPosition);
    }

    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("hashchange", scheduleUpdate);
    window.addEventListener("resize", scheduleUpdate, { passive: true });
    window.addEventListener("pageshow", scheduleUpdate);
    const observer = new ResizeObserver(() => {
      scheduleUpdate();
      if (toc?.open && current) positionCursor(current);
    });
    observer.observe(prose);
    if (list) observer.observe(list);
    progress.hidden = false;
    scheduleUpdate();
  }
</script>
