---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts, postPath } from "../lib/posts";
import { SERIES, withBase } from "../lib/site";

const posts = await getPosts();
const counts = {
  all: posts.length,
  kepu: posts.filter((p) => p.data.series === "kepu").length,
  notes: posts.filter((p) => p.data.series === "notes").length,
};
const latest = posts[0]?.data.date.toISOString().slice(5, 10);
const readingGuide = [
  { id: "ep02-vla-1", topic: "机器人学习", title: "VLA 怎样学会动手" },
  { id: "stanford-agent-skill", topic: "Agent 系统", title: "从 agent loop 到生产评测" },
  { id: "macmimic", topic: "工程复现", title: "在 Apple Silicon 上实现 MacMimic" },
].flatMap((entry) => {
  const post = posts.find(({ id }) => id === entry.id);
  return post ? [{ ...entry, href: withBase(postPath(post)) }] : [];
});
---

<Base current="posts">
  <section class="hero">
    <div>
      <div class="prompt"><span class="user">yusen@blog</span>:~$ <span class="cmd">cat README.md</span></div>
      <h1 class="hero-title px">YUSEN_BLOG</h1>
      <div class="hero-lede">
        <p class="zh px">献给我最热爱的Robotics and Artificial Intelligence</p>
        <p>Robotics &amp; AI, explained with the math, the papers, and experiments I ran myself.</p>
      </div>
      <p class="hero-meta">{counts.all} 篇文章 · {counts.kepu} 期视频{latest && ` · 更新于 ${latest}`}</p>
    </div>
    {readingGuide.length > 0 && (
      <nav class="reading-guide" aria-labelledby="guide-title">
        <h2 class="px zh-px" id="guide-title">从这里开始</h2>
        <ul>
          {readingGuide.map(({ href, topic, title }) => (
            <li>
              <a href={href}>
                <span class="guide-topic">{topic}</span>
                <span>{title}</span>
                <span class="guide-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </section>

  <section id="posts" aria-labelledby="posts-title">
    <div class="toolbar">
      <h2 class="px zh-px" id="posts-title">文章索引</h2>
      <div class="archive-controls">
        <input type="search" id="post-search" aria-label="搜索文章" placeholder="搜索标题、主题或期数" />
        <div class="filters" role="group" aria-label="筛选文章类型">
          <button class="filter" type="button" data-filter="all" aria-pressed="true">全部<span class="n">{counts.all}</span></button>
          <button class="filter" type="button" data-filter="kepu" aria-pressed="false">{SERIES.kepu.label}<span class="n">{counts.kepu}</span></button>
          <button class="filter" type="button" data-filter="notes" aria-pressed="false">{SERIES.notes.label}<span class="n">{counts.notes}</span></button>
        </div>
      </div>
    </div>
    <p class="post-count" id="post-count" role="status">{counts.all} 篇文章 · 按发布时间排序</p>
    <p class="post-empty" id="post-empty" hidden>
      没有找到匹配的文章。<button type="button" id="post-reset">查看全部文章</button>
    </p>
    <ul class="grid">
      {posts.map((post, i) => <PostCard post={post} feature={i === 0} />)}
    </ul>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter");
  const search = document.querySelector<HTMLInputElement>("#post-search")!;
  const count = document.querySelector<HTMLElement>("#post-count")!;
  const empty = document.querySelector<HTMLElement>("#post-empty")!;
  const normalize = (value: string) => value.normalize("NFKC").toLowerCase();
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".card"), (card) => ({
    card,
    text: normalize(card.dataset.search ?? ""),
  }));
  const params = new URLSearchParams(location.search);
  const seriesFilter = (value?: string | null) => value === "kepu" || value === "notes" ? value : "all";
  let filter = seriesFilter(params.get("s"));
  search.value = params.get("q") ?? "";

  function apply() {
    const query = search.value.trim();
    const terms = query ? normalize(query).split(/\s+/) : [];
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.filter === filter));
    let visible = 0;
    for (const { card, text } of cards) {
      const show = (filter === "all" || card.dataset.series === filter) &&
        terms.every((term) => text.includes(term));
      card.hidden = !show;
      card.classList.toggle("feature", show && visible === 0);
      if (show) visible++;
    }
    count.textContent = `${visible} 篇文章 · 按发布时间排序`;
    empty.hidden = visible !== 0;
  }

  function update() {
    apply();
    const url = new URL(location.href);
    if (filter === "all") url.searchParams.delete("s");
    else url.searchParams.set("s", filter);
    const query = search.value.trim();
    if (query) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);
  }

  search.addEventListener("input", update);
  for (const b of buttons) {
    b.addEventListener("click", () => {
      filter = seriesFilter(b.dataset.filter);
      update();
    });
  }
  document.querySelector("#post-reset")?.addEventListener("click", () => {
    search.value = "";
    filter = "all";
    update();
    search.focus();
  });

  apply();
</script>
