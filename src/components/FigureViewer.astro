---
interface Props {
  sources: Record<string, string>;
}

const { sources } = Astro.props;
---

<dialog class="figure-viewer" aria-labelledby="figure-viewer-title" data-sources={JSON.stringify(sources)}>
  <header class="figure-viewer-header">
    <div>
      <h2 id="figure-viewer-title">图表原图</h2>
      <span data-figure-size></span>
    </div>
    <a target="_blank" rel="noopener">打开原图 ↗</a>
    <form method="dialog">
      <button type="submit" autofocus>关闭 <span aria-hidden="true">×</span></button>
    </form>
  </header>
  <div class="figure-viewer-stage" tabindex="0" aria-label="图表画面" aria-description="左右键切换图片；放大后 Shift 加左右键移动画面。适合屏幕时可单指左右滑动切图。">
    <p data-figure-status role="status">正在加载原图</p>
    <img alt="" draggable="false" hidden />
  </div>
  <footer class="figure-viewer-footer">
    <p data-figure-caption></p>
    <div class="figure-viewer-navigation" role="group" aria-label="切换图片">
      <button type="button" data-previous aria-label="上一张" aria-keyshortcuts="ArrowLeft" title="上一张（←）；放大后 Shift + ← 移动画面">←</button>
      <output data-position aria-label="图片序号" aria-live="polite" aria-atomic="true"></output>
      <button type="button" data-next aria-label="下一张" aria-keyshortcuts="ArrowRight" title="下一张（→）；放大后 Shift + → 移动画面">→</button>
    </div>
    <div class="figure-viewer-tools" role="group" aria-label="图表缩放">
      <button type="button" data-zoom-out aria-label="缩小" disabled>−</button>
      <output data-zoom-percent aria-label="缩放比例"></output>
      <button type="button" data-zoom-in aria-label="放大" disabled>+</button>
      <button type="button" data-fit disabled>适合屏幕</button>
      <button type="button" data-actual disabled>原尺寸</button>
    </div>
  </footer>
</dialog>

<script>
  const viewer = document.querySelector<HTMLDialogElement>(".figure-viewer");
  const thumbnails = document.querySelectorAll<HTMLImageElement>(".prose img");

  if (viewer && thumbnails.length && typeof viewer.showModal === "function") {
    const sources: Record<string, string> = JSON.parse(viewer.dataset.sources ?? "{}");
    const original = viewer.querySelector("a")!;
    const stage = viewer.querySelector<HTMLElement>(".figure-viewer-stage")!;
    let image = stage.querySelector("img")!;
    const status = stage.querySelector<HTMLElement>("[data-figure-status]")!;
    const caption = viewer.querySelector("[data-figure-caption]")!;
    const size = viewer.querySelector("[data-figure-size]")!;
    const percent = viewer.querySelector<HTMLOutputElement>("[data-zoom-percent]")!;
    const position = viewer.querySelector<HTMLOutputElement>("[data-position]")!;
    const previousButton = viewer.querySelector<HTMLButtonElement>("[data-previous]")!;
    const nextButton = viewer.querySelector<HTMLButtonElement>("[data-next]")!;
    const zoomOut = viewer.querySelector<HTMLButtonElement>("[data-zoom-out]")!;
    const zoomIn = viewer.querySelector<HTMLButtonElement>("[data-zoom-in]")!;
    const fitButton = viewer.querySelector<HTMLButtonElement>("[data-fit]")!;
    const actualButton = viewer.querySelector<HTMLButtonElement>("[data-actual]")!;
    const maxZoom = 2;
    const zoomStep = 1.4;
    const stagePadding = 24;
    type Point = { x: number; y: number };
    const pointers = new Map<number, Point>();
    let zoom = 1;
    let fittedZoom = 1;
    let activeTrigger: HTMLAnchorElement | undefined;
    const entries: { trigger: HTMLAnchorElement; thumbnail: HTMLImageElement }[] = [];
    let currentIndex = -1;
    let swipe: (Point & { pointerId: number }) | undefined;

    const fit = () => Math.min(1,
      (stage.clientWidth - stagePadding) / image.naturalWidth,
      (stage.clientHeight - stagePadding) / image.naturalHeight,
    );

    const center = () => {
      const box = stage.getBoundingClientRect();
      return { x: box.left + box.width / 2, y: box.top + box.height / 2 };
    };

    const setZoom = (requested: number, from = center(), to = from) => {
      if (image.hidden || !viewer.open) return;
      const before = image.getBoundingClientRect();
      const imageX = (from.x - before.left) / before.width;
      const imageY = (from.y - before.top) / before.height;
      fittedZoom = fit();
      zoom = Math.max(fittedZoom, Math.min(maxZoom, requested));
      image.style.width = `${image.naturalWidth * zoom}px`;
      const after = image.getBoundingClientRect();
      stage.scrollLeft += after.left + imageX * after.width - to.x;
      stage.scrollTop += after.top + imageY * after.height - to.y;
      percent.value = `${Math.round(zoom * 100)}%`;
      zoomOut.disabled = false;
      zoomIn.disabled = false;
      zoomOut.setAttribute("aria-disabled", String(zoom <= fittedZoom));
      zoomIn.setAttribute("aria-disabled", String(zoom >= maxZoom));
      fitButton.disabled = false;
      actualButton.disabled = false;
    };

    const showImage = () => {
      image.style.width = `${image.naturalWidth * fit()}px`;
      image.hidden = false;
      status.hidden = true;
      size.textContent = `${image.naturalWidth} × ${image.naturalHeight}`;
      setZoom(fit());
    };

    const selectImage = (index: number) => {
      if (index < 0 || index >= entries.length) return;
      currentIndex = index;
      const { trigger, thumbnail } = entries[index];
      pointers.clear();
      swipe = undefined;
      // A fresh element prevents a late load/error from the previous image updating this one.
      const nextImage = document.createElement("img");
      nextImage.hidden = true;
      nextImage.draggable = false;
      nextImage.alt = thumbnail.alt;
      image.replaceWith(nextImage);
      image = nextImage;
      caption.textContent = thumbnail.closest("figure")?.querySelector("figcaption")?.textContent ?? thumbnail.alt;
      original.href = trigger.href;
      position.value = `${index + 1} / ${entries.length}`;
      previousButton.setAttribute("aria-disabled", String(index === 0));
      nextButton.setAttribute("aria-disabled", String(index === entries.length - 1));
      status.hidden = false;
      status.textContent = "正在加载原图";
      size.textContent = "";
      percent.value = "";
      if ([zoomOut, zoomIn, fitButton, actualButton].includes(document.activeElement as HTMLButtonElement)) {
        stage.focus({ preventScroll: true });
      }
      [zoomOut, zoomIn, fitButton, actualButton].forEach((button) => { button.disabled = true; });
      stage.scrollTo(0, 0);
      nextImage.addEventListener("load", () => {
        if (image === nextImage && viewer.open && nextImage.naturalWidth) showImage();
      });
      nextImage.addEventListener("error", () => {
        if (image === nextImage) status.textContent = "原图加载失败，可用上方链接重试。";
      });
      nextImage.src = original.href;
    };

    thumbnails.forEach((thumbnail) => {
      // Preserve author-supplied links rather than nesting a second anchor inside them.
      if (thumbnail.closest("a")) return;
      const authoredSource = thumbnail.dataset.originalSrc ?? "";
      const source = sources[authoredSource.replace(/^\.\//, "")] ?? (thumbnail.currentSrc || thumbnail.src);
      const trigger = document.createElement("a");
      trigger.className = "figure-open";
      trigger.href = source;
      trigger.target = "_blank";
      trigger.rel = "noopener";
      trigger.setAttribute("aria-haspopup", "dialog");
      trigger.setAttribute("aria-label", `放大图片：${thumbnail.alt || "正文配图"}`);
      const hint = document.createElement("span");
      hint.textContent = "放大图片 ↗";
      thumbnail.replaceWith(trigger);
      trigger.append(thumbnail, hint);
      const index = entries.push({ trigger, thumbnail }) - 1;

      trigger.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        activeTrigger = trigger;
        viewer.showModal();
        selectImage(index);
      });
    });

    previousButton.addEventListener("click", () => selectImage(currentIndex - 1));
    nextButton.addEventListener("click", () => selectImage(currentIndex + 1));
    viewer.addEventListener("keydown", (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      if (event.shiftKey) {
        stage.scrollLeft += event.key === "ArrowRight" ? 80 : -80;
        return;
      }
      selectImage(currentIndex + (event.key === "ArrowRight" ? 1 : -1));
    });
    viewer.addEventListener("close", () => {
      pointers.clear();
      swipe = undefined;
      activeTrigger?.focus({ preventScroll: true });
    });

    new ResizeObserver(() => {
      if (viewer.open && !image.hidden) setZoom(zoom === fittedZoom ? fit() : zoom);
    }).observe(stage);

    zoomOut.addEventListener("click", () => {
      if (zoomOut.getAttribute("aria-disabled") !== "true") setZoom(zoom / zoomStep);
    });
    zoomIn.addEventListener("click", () => {
      if (zoomIn.getAttribute("aria-disabled") !== "true") setZoom(zoom * zoomStep);
    });
    fitButton.addEventListener("click", () => setZoom(fit()));
    actualButton.addEventListener("click", () => setZoom(1));

    stage.addEventListener("wheel", (event) => {
      if (image.hidden || !event.deltaY) return;
      event.preventDefault();
      const delta = Math.max(-100, Math.min(100, event.deltaY));
      setZoom(zoom * Math.exp(-delta / 240), { x: event.clientX, y: event.clientY });
    }, { passive: false });

    stage.addEventListener("pointerdown", (event) => {
      if (image.hidden || event.button !== 0 || pointers.size >= 2) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (pointers.size === 1 && event.pointerType === "touch" && zoom <= fittedZoom + 0.001) {
        swipe = { pointerId: event.pointerId, x: event.clientX, y: event.clientY };
      } else {
        swipe = undefined;
      }
      stage.setPointerCapture(event.pointerId);
    });

    const midpoint = (first: Point, second: Point) => ({
      x: (first.x + second.x) / 2,
      y: (first.y + second.y) / 2,
    });

    stage.addEventListener("pointermove", (event) => {
      const previous = pointers.get(event.pointerId);
      if (!previous) return;
      const current = { x: event.clientX, y: event.clientY };
      pointers.set(event.pointerId, current);
      if (pointers.size === 1) {
        stage.scrollLeft += previous.x - current.x;
        stage.scrollTop += previous.y - current.y;
        return;
      }
      const other = [...pointers].find(([id]) => id !== event.pointerId)![1];
      const before = Math.hypot(previous.x - other.x, previous.y - other.y);
      const after = Math.hypot(current.x - other.x, current.y - other.y);
      if (before > 0 && after > 0) {
        setZoom(zoom * after / before, midpoint(previous, other), midpoint(current, other));
      }
    });

    stage.addEventListener("pointerup", (event) => {
      const start = swipe;
      swipe = undefined;
      pointers.delete(event.pointerId);
      if (!start || start.pointerId !== event.pointerId) return;
      const dx = event.clientX - start.x;
      const dy = event.clientY - start.y;
      if (Math.abs(dx) >= 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        selectImage(currentIndex + (dx < 0 ? 1 : -1));
      }
    });
    const cancelPointer = (event: PointerEvent) => {
      pointers.delete(event.pointerId);
      swipe = undefined;
    };
    stage.addEventListener("pointercancel", cancelPointer);
    stage.addEventListener("lostpointercapture", cancelPointer);
  }
</script>

<style is:global>
  html:has(.figure-viewer[open]) {
    overflow: hidden;
  }

  .prose .figure-open {
    position: relative;
    display: block;
    text-decoration: none;
    cursor: zoom-in;
  }

  .prose .figure-open span {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 5px 9px;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    background: var(--bg);
    color: var(--text-strong);
    font: 12px/1.5 var(--font-mono);
  }

  .figure-viewer {
    box-sizing: border-box;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #181a1e;
    color: #f4f4f4;
    font: 13px/1.5 var(--font-mono);
  }

  .figure-viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .figure-viewer-header,
  .figure-viewer-footer {
    display: flex;
    align-items: center;
    gap: 8px 16px;
    padding: 10px clamp(12px, 3vw, 32px);
    background: #22252b;
  }

  .figure-viewer-header > div,
  .figure-viewer-footer > p {
    flex: 1 1 auto;
    min-width: 0;
  }

  .figure-viewer h2 {
    margin: 0;
    font: 400 24px/1.3 var(--font-pixel-zh);
    -webkit-font-smoothing: none;
  }

  .figure-viewer-header [data-figure-size],
  .figure-viewer-footer > p {
    color: #c6c9d0;
    font-size: 12px;
  }

  .figure-viewer-header a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .figure-viewer form,
  .figure-viewer-footer > p {
    margin: 0;
  }

  .figure-viewer button {
    min-width: 44px;
    min-height: 44px;
    padding: 6px 10px;
    border: 1px solid #616670;
    border-radius: 3px;
    background: #30343c;
    color: inherit;
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
  }

  .figure-viewer button:disabled,
  .figure-viewer button[aria-disabled="true"] {
    opacity: 0.45;
    cursor: default;
  }

  .figure-viewer :focus-visible {
    outline: 2px solid #ffac7b;
    outline-offset: 2px;
  }

  .figure-viewer-stage {
    display: flex;
    overflow: auto;
    padding: 12px;
    overscroll-behavior: contain;
    scrollbar-width: none;
    touch-action: none;
    user-select: none;
    cursor: grab;
  }

  .figure-viewer-stage:active { cursor: grabbing; }

  .figure-viewer-stage img {
    flex: none;
    max-width: none;
    height: auto;
    margin: auto;
    object-fit: contain;
  }

  .figure-viewer-stage img[hidden] { display: none; }

  .figure-viewer-stage p { margin: auto; }

  .figure-viewer-tools,
  .figure-viewer-navigation {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: none;
  }

  .figure-viewer-tools output,
  .figure-viewer-navigation output {
    min-width: 4ch;
    color: #ffb18c;
    text-align: center;
  }

  .figure-viewer-navigation output { min-width: 6ch; }

  @media (max-width: 640px) {
    .figure-viewer-header { gap: 8px; }
    .figure-viewer-footer { flex-wrap: wrap; }
    .figure-viewer-footer > p { flex-basis: 100%; }
    .figure-viewer-navigation { flex-basis: 100%; justify-content: center; }
    .figure-viewer-tools { margin-inline: auto; }
  }
</style>
